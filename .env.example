# ═══════════════════════════════════════════════════════════════
# PORTFOLIO ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# This project uses an EXTERNAL PostgreSQL database (not Dockerized).
# Run ./setup-db.sh to seed the database schema and roles.
# ═══════════════════════════════════════════════════════════════

# ─── Ports ────────────────────────────────────────────────────
BACKEND_PORT=3838
FRONTEND_PORT=3355

# ─── External PostgreSQL ──────────────────────────────────────
# Used by setup-db.sh and Docker containers (via host.docker.internal)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=portfolio

# ─── Supabase URLs ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:3838
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTYwMzk5ODA5MiwiZXhwIjoyNzUyMTQ0NDkyLCJyb2xlIjoiYW5vbiJ9.3VZgKmfOqXHE7wJpJLNl5K2XxGeDnR_U5GhHjlGneVk
