# ═══════════════════════════════════════════════════════════════
# PORTFOLIO ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# This project uses Supabase Cloud by default.
# Legacy self-hosted keys/URLs are marked below and only needed
# for the local self-hosted flow (USE_SUPABASE_PROXY=true).
# ═══════════════════════════════════════════════════════════════

# ─── Ports ────────────────────────────────────────────────────
BACKEND_PORT=3838
FRONTEND_PORT=3355

# ─── Site ──────────────────────────────────────────────────────
# Canonical site origin used for sitemap.xml <loc>, <link rel="canonical">,
# og:url and JSON-LD @id values. Leave unset in production to use the built-in
# fallback (https://fahimaloy.dev); set it to your own host for staging/preview
# so those deployments do not emit production canonical URLs.
# NEXT_PUBLIC_SITE_URL=https://your-host.example

# ─── External PostgreSQL ──────────────────────────────────────
# Used by setup-db.sh and Docker containers (via host.docker.internal)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=portfolio

# ─── Supabase Cloud (active) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dummy
NEXT_PUBLIC_SUPABASE_SECRET_KEY=sb_secret_dummy
NEXT_PUBLIC_SUPABASE_PROJECT_NAME=your-project-name
NEXT_PUBLIC_SUPABASE_PROJECT_ID=your-project-ref
NEXT_PUBLIC_SUPABASE_REGION=your-region
NEXT_PUBLIC_SUPABASE_DB_CONNECTION_STRING=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# ─── Supabase legacy / self-host-only ─────────────────────────
# Legacy cloud keys (transition fallback only):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Legacy self-host-only (Kong / local gateway / local JWT):
# ANON_KEY=
# SERVICE_ROLE_KEY=
# JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
# KONG_HTTP_PORT=3838
# KONG_HTTPS_PORT=8443
# PUBLIC_REST_URL=http://localhost:3838
# PUBLIC_AUTH_URL=http://localhost:3838/auth/v1
# POSTGRES_* above are also self-host-oriented; Cloud uses
# NEXT_PUBLIC_SUPABASE_DB_CONNECTION_STRING instead.
# Legacy local URL example: NEXT_PUBLIC_SUPABASE_URL=http://localhost:3838

# ─── Site & URLs ─────────────────────────────────────────────
SITE_URL=http://localhost:3355

# ─── SMTP (MailHog for dev) ───────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@localhost

# ─── Admin credentials (seeded on first run) ──────────────────
# The password MUST be 12+ characters and not a known placeholder, or seeding
# is refused and you must create the admin user by hand. Generate one with:
#   openssl rand -base64 24
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=
ADMIN_DEFAULT_EMAIL=admin@localhost

# ─── Gemini AI (optional) ─────────────────────────────────────
GEMINI_API_KEY=

# ─── Legacy API fallback (optional) ───────────────────────────
NEXT_PUBLIC_API=
