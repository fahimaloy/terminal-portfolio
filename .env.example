# ═══════════════════════════════════════════════════════════════
# PORTFOLIO ENVIRONMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════

# ─── Mode selection ───────────────────────────────────────────
# Set to "cloud" for Supabase Cloud or "selfhosted" for local/VPS
SUPABASE_MODE=selfhosted

# ─── Self-hosted Supabase (Docker) ────────────────────────────
# When SUPABASE_MODE=selfhosted, these point to your Docker services.
# Defaults work for local Docker deployment on the same machine.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTYwMzk5ODA5MiwiZXhwIjoyNzUyMTQ0NDkyLCJyb2xlIjoiYW5vbiJ9.3VZgKmfOqXHE7wJpJLNl5K2XxGeDnR_U5GhHjlGneVk
SUPABASE_SERVICE_ROLE_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJpc3MiOiJzdXBhYmFzZSIsImlhdCI6MTYwMzk5ODA5MiwiZXhwIjoyNzUyMTQ0NDkyLCJyb2xlIjoic2VydmljZV9yb2xlIn0.ZBm1V6gW6pLPYHKJhSFMfcsGg_XM5m3HzBJSKpVqG8A

# ─── Supabase Cloud (alternative) ─────────────────────────────
# Uncomment and set these when using Supabase Cloud instead.
# Copy from: Settings > API > Project API keys in your Supabase dashboard.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Self-hosted Docker backend config ────────────────────────
# These are used by docker-compose.supabase.yml only.
# Change the JWT_SECRET to a secure random value in production.
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
POSTGRES_PASSWORD=supabase_db_password
POSTGRES_DB=supabase
POSTGRES_PORT=5432
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ═══════════════════════════════════════════════════════════════

# ─── Admin credentials (seeded on first run) ──────────────────
ADMIN_DEFAULT_USERNAME=fahimaloy
ADMIN_DEFAULT_PASSWORD=dibona
ADMIN_DEFAULT_EMAIL=private.fahimaloy@proton.me

# ─── Gemini AI (optional - can also configure models via admin dashboard) ───
# If GEMINI_API_KEY is set, it serves as a fallback when no models are configured
# in the admin dashboard. For full control (multiple models, load balancing, rate limits),
# configure providers and models in the admin dashboard instead.
GEMINI_API_KEY=

# ─── Legacy API fallback (optional) ───────────────────────────
NEXT_PUBLIC_API=

# ─── SMTP for auth emails (self-hosted only) ──────────────────
# MailHog is included in Docker Compose for development.
# For production, configure real SMTP credentials.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@localhost
SITE_URL=http://localhost:3000
