# ─── Site & URLs ─────────────────────────────────────────────
SITE_URL=http://localhost:3355
PUBLIC_REST_URL=http://localhost:3838
PUBLIC_AUTH_URL=http://localhost:3838/auth/v1

# ─── Kong Ports ───────────────────────────────────────────────
KONG_HTTP_PORT=3838
KONG_HTTPS_PORT=8443

# ─── SMTP (MailHog for dev) ───────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@localhost

# ─── Admin credentials (seeded on first run) ──────────────────
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=changeme
ADMIN_DEFAULT_EMAIL=admin@localhost

# ─── Gemini AI (optional) ─────────────────────────────────────
GEMINI_API_KEY=

# ─── Legacy API fallback (optional) ───────────────────────────
NEXT_PUBLIC_API=
