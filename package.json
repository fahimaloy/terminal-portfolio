{
  "name": "fahimaloy-portfolio",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Fahim Ahmed",
    "email": "fahimaloy@gmail.com"
  },
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "build": "bash ./scripts/build.sh",
    "start": "dotenv -- next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check && node scripts/token-lint.mjs --all --warn-legacy",
    "tokens:check:strict": "node scripts/generate-tokens.mjs --check && node scripts/token-lint.mjs --all",
    "verify": "npm run lint && npm run typecheck && npm test && npm run tokens:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.99.0",
    "@tiptap/extension-code-block-lowlight": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/dompurify": "^3.0.5",
    "animejs": "^4.5.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.11",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.23.0",
    "markdown-to-jsx": "^7.1.7",
    "next": "12.1.6",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-icons": "^4.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.41",
    "@types/react": "18.0.9",
    "@types/react-dom": "18.0.3",
    "@typescript-eslint/eslint-plugin": "^5.23.0",
    "@typescript-eslint/parser": "^5.23.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^1.6.1",
    "autoprefixer": "^10.4.7",
    "dotenv-cli": "^11.0.0",
    "eslint": "8.15.0",
    "eslint-config-next": "^12.1.6",
    "eslint-plugin-next": "^0.0.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-react": "^7.29.4",
    "husky": "^8.0.1",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.13",
    "prettier": "^2.6.2",
    "tailwindcss": "^3.0.24",
    "typescript": "^4.6.4",
    "vitest": "^1.6.1"
  }
}
