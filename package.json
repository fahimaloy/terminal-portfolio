{
  "name": "fahimaloy-portfolio",
  "version": "0.1.0",
  "license": "MIT",
  "author": {
    "name": "Fahim Ahmed",
    "email": "fahimaloy@gmail.com"
  },
  "scripts": {
    "dev": "bash ./scripts/dev.sh",
    "build": "bash ./scripts/build.sh",
    "start": "dotenv -- next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check && node scripts/token-lint.mjs --all --warn-legacy",
    "tokens:check:strict": "node scripts/generate-tokens.mjs --check && node scripts/token-lint.mjs --all",
    "verify": "npm run lint && npm run typecheck && npm test && npm run tokens:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e",
    "prepare": "husky install"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "overrides": {
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.8.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/dompurify": "^3.0.5",
    "animejs": "^4.5.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.16",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.23.0",
    "markdown-to-jsx": "^7.1.7",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^4.3.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@commitlint/cli": "17.8.1",
    "@commitlint/config-conventional": "17.8.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.41",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "4.1.11",
    "autoprefixer": "^10.6.1",
    "dependency-cruiser": "^18.2.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.29.4",
    "husky": "^8.0.1",
    "jsdom": "^24.1.3",
    "madge": "^8.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
